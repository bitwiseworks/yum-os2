"""Installation directories generated by make. Do not edit paths.py."""

import os

ROOTPREFIX = '@ROOTPREFIX@' # must be /-terminated
PREFIX = '@PREFIX@'
SYSCONFDIR = '@SYSCONFDIR@'
LOCALSTATEDIR = '@LOCALSTATEDIR@'

def rooted(root, path):
    """Concatenate root and path, collapsing leading ROOTPREFIX repeats."""
    root = os.path.normpath(root)
    path = os.path.normpath(path)
    if (root == '/' and path.startswith('/')) or \
        (path.startswith(root) and (len(path) == len(root) or \
            path[len(root)] == '/')):
        return path
    return root.rstrip('/') + '/' + path.lstrip('/')
